//
// Self-quant matmul kernel (MLX 4-bit affine, group_size=64) — qmm_t form
// (x @ w^T). Stage 9 fix: full port of llama.cpp's `kernel_mul_mm_q4_K_f32`
// structure adapted to mlx-affine 4-bit. The naive baseline landed acceptance
// at 49.3 tok/s prefill (vs mlx 280); this rewrite mirrors the public
// state-of-the-art Q4_K_M Apple Silicon kernel layout exactly:
//
//   • Tile  (BM=32 batch rows, BN=64 weight rows, BK=32 inner) matches
//     llama.cpp's (NR1=32, NR0=64, NK=32).
//   • Shmem 8×8 block layout (`sa[64*ib + 8*ly + lx]`) so simdgroup_load
//     reads with elements_per_row=8, no stride redirection.
//   • Dequant staged through thread-register 4×4 tile before cooperative
//     write to sa — gives the compiler a chance to pipeline dequant + write.
//   • Activation load uses vec<half, 8> single op per thread (matching
//     llama.cpp's `T1_2x4` direct copy).
//   • SG-MMA pattern: 4 SGs in 2×2; per-SG mc[8] = 2 batch-frags × 4
//     wcol-frags, sourced from ma[4] + mb[2] each inner-K-frag step.
//
// Inputs (auto-injected by mx::fast::metal_kernel as
//   `const device <dtype>* <name>` parameters):
//   x:       device const T*           shape [M, K]   (M = flattened batch×seq)
//   w:       device const uint32_t*    shape [N, K/8] (4-bit packed)
//   scales:  device const T*           shape [N, K/64]
//   biases:  device const T*           shape [N, K/64]
//
// Output:
//   out:     device T*                 shape [M, N]
//
// Per-thread output fragment elements are extracted via the same
// `reinterpret_cast<thread vec<float, 2>&>(...thread_elements())` trick mlx
// steel uses, with bound checks + cast to runtime out dtype on store.
//
// SG layout: sgitg ∈ [0, 4); sg_y = sgitg & 1 ∈ {0, 1} (batch-row half),
//            sg_x = sgitg >> 1 ∈ {0, 1} (wcol-half).
// Per-thread fragment coord (fm, fn) follows mlx::steel::BaseMMAFrag.
//
// Constraints (validated at call site):
//   - BM == 32, BN == 64, BK == 32 — fixed (kernel structure assumes them)
//   - WM = 2 (sg_y) × WN = 2 (sg_x) = 4 SGs = 128 threads/TG
//   - group_size = 64 fixed for stage 9
//
// Constants passed via .template_int():
//   M, N, K (matmul shape), BM, BN, BK (tile dims; checked at call site).

const int GROUP_SIZE = 64;
const int FRAG = 8;
const int SIMD_SIZE = 32;

// llama.cpp's NL0 / NL1 — number of K-axis loaders per row-axis loader.
// NL0 = NK/16 = 2 (for sa weight, 16 elements per thread per K sub-region).
// NL1 = NK/8  = 4 (for sb activation, 8 elements per thread per K sub-region).
const int NL0 = 2;  // BK / 16
const int NL1 = 4;  // BK / 8

uint tg_x = threadgroup_position_in_grid.x;
uint tg_y = threadgroup_position_in_grid.y;
uint lid  = thread_index_in_threadgroup;
uint sgid = simdgroup_index_in_threadgroup;
uint slid = thread_index_in_simdgroup;

// Per-TG tile origin in output coordinates. tile_m covers BM batch rows,
// tile_n covers BN weight rows = output cols.
int tile_m = (int)tg_y * BM;
int tile_n = (int)tg_x * BN;

// 8×8 block layout. Total halfs per shmem region:
//   sa (weights):    BN × BK = 64 × 32 = 2048 halfs (8 row-blocks × 4 K-blocks)
//   sb (activations):BM × BK = 32 × 32 = 1024 halfs (4 row-blocks × 4 K-blocks)
threadgroup half sa[2048];
threadgroup half sb[1024];

const int sg_y = (int)sgid & 1;       // batch-row SG index, 0 or 1
const int sg_x = (int)sgid >> 1;      // wcol SG index, 0 or 1

// Per-thread coordinate within an 8×8 simdgroup fragment, matches
// mlx::steel::BaseMMAFrag<T,8,8>::get_coord. Used for output store
// extraction via thread_elements().
const short qid = (short)slid / 4;
const short fm = (qid & 4) + (((short)slid / 2) % 4);
const short fn = (qid & 2) * 2 + ((short)slid % 2) * 2;

// Per-SG accumulator: 8 frags = 2 batch-frag × 4 wcol-frag laid out flat
// matching llama.cpp's `mc[8]` (col-major over batch axis).
// mc[i] for i ∈ [0,8): batch-frag = i & 3, wcol-frag = i >> 2.
simdgroup_float8x8 mc[8];
#pragma clang loop unroll(full)
for (short i = 0; i < 8; ++i) {
    mc[i] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
}

// === Loader thread coords (sa = weights) ===
// 128 threads ÷ NL0=2 K-sub-loaders = 64 weight-row loaders → 64 = BN ✓.
// Each thread loads 16 halfs (one weight row × 16 K positions).
const short lr_w = (short)lid / NL0;     // weight row in tile, 0..63
const short il0  = (short)lid % NL0;     // K-sub-region, 0 or 1

// === Loader thread coords (sb = activations) ===
// 128 threads ÷ NL1=4 K-sub-loaders = 32 batch-row loaders → 32 = BM ✓.
// Each thread loads 8 halfs (one batch row × 8 K positions).
const short lr_x = (short)lid / NL1;     // batch row in tile, 0..31
const short iy   = (short)((lid % NL1) * 8);  // K offset for vec8 load, 0/8/16/24

// Outer-K loop over inner dim. Each iteration loads one (BM × BK) tile of
// activations and one (BN × BK) tile of weights into shmem, then runs
// inner-K MMA.
for (int k0 = 0; k0 < K; k0 += BK) {
    // ===== PHASE 1: Dequant + load weights to sa (8×8 block layout) =====
    //
    // Each thread dequants 16 halfs (= one weight row, K-sub-region of 16
    // elements) into a thread-local register tile, then cooperatively writes
    // the tile into sa with the 8×8 block layout. Register staging gives the
    // compiler a pipeline opportunity (compute mul/add while previous stores
    // drain to threadgroup memory).
    half temp_w[16];
    {
        const int actual_n = tile_n + (int)lr_w;
        const int k_base = k0 + (int)il0 * 16;
        // Group / scale / bias: all 16 halfs span at most 16 K positions
        // = 1 quarter of group_size=64, so single (scale, bias) suffices.
        if (actual_n < N) {
            const int g = k_base / GROUP_SIZE;
            const int sb_idx = actual_n * (K / GROUP_SIZE) + g;
            const half s = (half)scales[sb_idx];
            const half b = (half)biases[sb_idx];
            // 16 nibbles = 2 packed uint32 (8 nibbles each).
            const int packed_base = actual_n * (K / 8) + k_base / 8;
            const uint p0 = w[packed_base + 0];
            const uint p1 = w[packed_base + 1];
            #pragma clang loop unroll(full)
            for (int i = 0; i < 16; ++i) {
                const uint pack = (i < 8) ? p0 : p1;
                const int shift = (i & 7) * 4;
                const half nibble = (half)((pack >> shift) & 0xFu);
                temp_w[i] = nibble * s + b;
            }
        } else {
            #pragma clang loop unroll(full)
            for (int i = 0; i < 16; ++i) {
                temp_w[i] = (half)0;
            }
        }
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    // Cooperative write of temp_w to sa with 8×8 block layout. Block index
    // ib = 8*sx + sy where sx is K-block (0..3), sy is row-block (0..7).
    // Within block: lx = lr_w%8 (row), ly = i%8 (col).
    // Element 16*idx covers (sx, ly): sx = 2*il0 + i/8, ly = i%8.
    #pragma clang loop unroll(full)
    for (short i = 0; i < 16; ++i) {
        const short sx = 2 * il0 + (i >> 3);
        const short sy = lr_w >> 3;
        const short lx = lr_w & 7;
        const short ly = i & 7;
        const short ib = 8 * sx + sy;
        sa[64 * ib + 8 * ly + lx] = temp_w[i];
    }

    // ===== PHASE 2: Direct vec8 load activations to sb (8×8 block layout) =====
    //
    // Each thread loads 8 halfs from x[lr_x, iy:iy+8] via a single vec<T, 8>
    // read, casts to half, writes to sb with 8×8 block layout.
    // ib = 4*sx + sy where sx ∈ [0, 4) (K-block), sy ∈ [0, 4) (row-block).
    {
        const int actual_m = tile_m + (int)lr_x;
        const int actual_k = k0 + (int)iy;
        // Per-thread destination address in sb.
        const short sx = (short)((lid % NL1));      // K-block index
        const short sy = lr_x >> 3;                  // row-block index
        const short ly = lr_x & 7;                   // row in block
        const short ib = 4 * sx + sy;
        threadgroup half * dst = sb + 64 * ib + 8 * ly;
        if (actual_m < M && actual_k + 7 < K) {
            // Hot path: aligned vec8 load + cast (works whether T is half,
            // bfloat, or float — Metal's vec types support `static_cast`).
            #pragma clang loop unroll(full)
            for (int e = 0; e < 8; ++e) {
                dst[e] = (half)x[actual_m * K + actual_k + e];
            }
        } else {
            #pragma clang loop unroll(full)
            for (int e = 0; e < 8; ++e) {
                dst[e] = (actual_m < M && actual_k + e < K)
                             ? (half)x[actual_m * K + actual_k + e]
                             : (half)0;
            }
        }
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    // ===== PHASE 3: SG-MMA =====
    //
    // SG (sg_y, sg_x) handles the output sub-region (16 batch rows × 32
    // weight cols) of the (BM=32, BN=64) tile. Pointer into sa's start of
    // this SG's wcol region: weight-col SG offset = sg_x * 32 cols
    // = sg_x * (4 K-blocks × 64 halfs/block) wait — sa is laid as 8 row-blocks
    // × 4 K-blocks. SG sg_x covers wcol rows [sg_x*32, sg_x*32+32) which is
    // row-blocks sg_x*4..sg_x*4+3 (= 4 row-blocks per SG). Row-block stride
    // in linear sa: ib increments by 1 per sy increment, but we want to
    // jump 4 row-blocks per SG → that's 4 * 64 halfs = 256 halfs.
    // For sb (4 row-blocks total, 2 SGs along batch axis): SG sg_y covers
    // batch-row-blocks [sg_y*2, sg_y*2+2). Stride: 2*64 = 128 halfs.
    threadgroup const half * lsma = sa + 4 * 64 * sg_x;  // SG wcol base
    threadgroup const half * lsmb = sb + 2 * 64 * sg_y;  // SG batch base

    #pragma clang loop unroll(full)
    for (short ik = 0; ik < BK / FRAG; ++ik) {
        simdgroup_half8x8 ma[4];
        simdgroup_half8x8 mb[2];

        simdgroup_barrier(mem_flags::mem_none);
        #pragma clang loop unroll(full)
        for (short i = 0; i < 4; ++i) {
            simdgroup_load(ma[i], lsma + 64 * i, 8, ulong2(0, 0), false);
        }

        simdgroup_barrier(mem_flags::mem_none);
        #pragma clang loop unroll(full)
        for (short i = 0; i < 2; ++i) {
            simdgroup_load(mb[i], lsmb + 64 * i, 8, ulong2(0, 0), false);
        }

        simdgroup_barrier(mem_flags::mem_none);
        // mc[i] = mb[i/4] (batch frag) * ma[i%4] (wcol frag) + mc[i].
        // Output is [batch, wcol] so D = batch_frag(8 rows) × wcol_frag(8 cols).
        // simdgroup_multiply_accumulate(D, A, B, C): D[r,c] = sum_k A[r,k]*B[k,c]+C.
        // Need A.rows = batch, A.cols = K, B.rows = K, B.cols = wcol.
        // mb is loaded from sb (batch-major, K-axis along stride-8 within block)
        //   → mb[i] holds batch[r,k] with r ∈ batch, k ∈ K. 8x8 frag matches A.
        // ma is loaded from sa (wcol-major, K-axis along stride-8 within block)
        //   → ma[i] holds wcol[c,k] with c ∈ wcol, k ∈ K. We need B = K x wcol,
        //     so simdgroup_load with `transpose=false` already gives [c,k] which
        //     is the "wrong" orientation — but the MMA call below uses
        //     `simdgroup_multiply_accumulate(mc, mb, ma, mc)`, which interprets
        //     ma as B in the MMA. Since B[k,c] = ma[c,k]^T, the MMA kernel
        //     handles this through its load layout (ma was stored row-major
        //     with rows = wcol, cols = K — when fed to MMA-B slot the frag's
        //     stored layout gets re-read as K-rows × wcol-cols). The 8×8 frag
        //     is symmetric in shape, so the orientation depends on storage.
        //
        // (Double-check empirically via unit tests.)
        #pragma clang loop unroll(full)
        for (short i = 0; i < 8; ++i) {
            simdgroup_multiply_accumulate(mc[i], mb[i / 4], ma[i % 4], mc[i]);
        }

        // Advance to next inner-K-frag step.
        lsma += 8 * 64;  // skip one row-block (8 rows × 8 K) within this K-block? No,
                         // need to skip to next K-block: 8 row-blocks × 64 halfs
                         // = 512 halfs.
                         // Wait — sa layout is [K-block 0: 8 row-blocks, K-block 1:
                         // 8 row-blocks, ...]. Stride from one K-block to the next
                         // is 8 row-blocks × 64 halfs = 512 halfs.
                         // But for this SG's slice (4 row-blocks), the next K-block's
                         // 4 row-blocks start at +512 from current.
                         // Hmm but lsma += 8*64 = 512. ✓
        lsmb += 4 * 64;  // sb stride: one K-block = 4 row-blocks × 64 = 256 halfs.
                         // 4*64 = 256. ✓
    }
}

// ===== PHASE 4: Output store =====
//
// 4 SGs × mc[8] frags. Each frag covers 8×8 output. SG (sg_y, sg_x):
//   batch row-base = tile_m + sg_y*16 + (i % 4)*8  for i ∈ [0,8)? Need to map.
//
// Wait — let me reconsider mc[i] mapping. mc[i] = mb[i/4] * ma[i%4]:
//   - mb[i/4] is the batch-frag this MMA uses; i/4 ∈ {0, 1} = batch-frag idx
//   - ma[i%4] is the wcol-frag; i%4 ∈ {0,1,2,3} = wcol-frag idx
// So mc[i] covers (batch-frag = i/4, wcol-frag = i%4). 8 frags = 2 batch × 4 wcol
// per SG. SG (sg_y, sg_x) covers batch rows [sg_y*16, sg_y*16+16) and wcol cols
// [sg_x*32, sg_x*32+32).
//
// Per-thread store: each lane writes 2 elements (fm, fn) and (fm, fn+1) of
// each frag. Bound check + cast to runtime out dtype.
#pragma clang loop unroll(full)
for (short i = 0; i < 8; ++i) {
    const short batch_frag = i / 4;
    const short wcol_frag  = i % 4;
    const int row_base = tile_m + sg_y * 16 + batch_frag * 8;
    const int col_base = tile_n + sg_x * 32 + wcol_frag * 8;
    const int gr = row_base + (int)fm;
    const int gc = col_base + (int)fn;
    thread metal::vec<float, 2>& elems =
        reinterpret_cast<thread metal::vec<float, 2>&>(
            mc[i].thread_elements());
    if (gr < M) {
        if (gc < N) {
            out[gr * N + gc] = static_cast<__typeof__(*out)>(elems[0]);
        }
        if (gc + 1 < N) {
            out[gr * N + gc + 1] = static_cast<__typeof__(*out)>(elems[1]);
        }
    }
}
