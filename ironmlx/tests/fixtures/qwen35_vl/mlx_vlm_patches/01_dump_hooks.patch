+def _maybe_dump(name: str, tensor):
+    """P6.1 diff hook. No-op unless MLXVLM_VISION_DUMP_DIR is set at call time.
+
+    See the IronMLX vision-diff test fixture documentation.
+    """
+    dump_dir = _os.environ.get("MLXVLM_VISION_DUMP_DIR")
+    if not dump_dir:
+        return
+    try:
+        mx.eval(tensor)
+        mx.save_safetensors(
+            _os.path.join(dump_dir, f"{name}.safetensors"),
+            {"tensor": tensor},
+        )
+    except Exception as e:
+        import sys
+        print(f"[mlxvlm-dump] {name} failed: {e}", file=sys.stderr)
